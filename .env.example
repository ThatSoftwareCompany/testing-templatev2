APP_NAME=testing-templatev2
APP_ENV=development
HTTP_ADDR=:8080
HTTP_READ_TIMEOUT=5s
HTTP_WRITE_TIMEOUT=10s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=10s
LOG_LEVEL=info

# PostgreSQL is enabled by default. Set DATABASE_ENABLED=false to run without it.
DATABASE_ENABLED=true
DATABASE_URL=postgres://DB_USER:DB_PASSWORD@localhost:5432/DB_NAME?sslmode=disable
DATABASE_MAX_CONNS=10
DATABASE_MIN_CONNS=1
DATABASE_HEALTH_TIMEOUT=3s

MIGRATIONS_DIR=file://migrations
MIGRATIONS_RUN_ON_STARTUP=false
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Authentication is active when PostgreSQL is enabled. Keep private keys and
# the CSRF secret outside the repository, for example in a secret manager.
AUTH_PRIVATE_KEY_FILE=.local/auth/private.pem
AUTH_PUBLIC_KEY_FILE=.local/auth/public.pem
AUTH_KEY_ID=local-development
AUTH_JWT_ISSUER=http://localhost:8080
AUTH_JWT_AUDIENCE=template-go-api
AUTH_CSRF_SECRET=
AUTH_ACCESS_TOKEN_TTL=15m
AUTH_REFRESH_TOKEN_TTL=720h

# Local Compose-only placeholders. Do not commit a real .env file.
POSTGRES_USER=DB_USER
POSTGRES_PASSWORD=DB_PASSWORD
POSTGRES_DB=DB_NAME
